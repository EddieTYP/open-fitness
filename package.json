{
  "name": "open-fitness",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "node --env-file-if-exists=.env.local scripts/start-self-host.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:privacy": "node --test tests/public-privacy.test.mjs tests/agent-plugin-package.test.mjs tests/public-readiness.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "auth:hash-owner": "node scripts/hash-owner-password.mjs",
    "db:backup:local": "node --env-file-if-exists=.env.local scripts/backup-sqlite.mjs",
    "db:generate": "drizzle-kit generate",
    "db:init:local": "node scripts/init-local-sqlite.mjs",
    "db:migrate:local": "node --env-file-if-exists=.env.local scripts/local-db-migrate.mjs",
    "db:restore:stopped": "node --env-file-if-exists=.env.local scripts/restore-stopped-sqlite.mjs",
    "db:verify-backup": "node scripts/verify-sqlite-backup.mjs",
    "self-host:activate": "node --env-file-if-exists=.env.local scripts/activate-self-host-release.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "overrides": {
    "@libsql/isomorphic-ws": {
      "ws": "8.21.2"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Open Fitness"
}

# Copy to .env.local and replace every placeholder. Never commit .env.local.

# Required application state and owner login.
FITNESS_SQLITE_PATH=/absolute/path/to/open-fitness-data/fitness.sqlite

# Required by backup and migration commands, not by normal page requests.
FITNESS_BACKUP_DIR=/absolute/path/to/open-fitness-data/backups

FITNESS_OWNER_PASSWORD_HASH=REPLACE_WITH_ESCAPED_SCRYPT_HASH
FITNESS_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
FITNESS_PUBLIC_ORIGIN=http://127.0.0.1:3000
FITNESS_RELEASE_ID=REPLACE_WITH_40_CHARACTER_GIT_COMMIT

# Optional. Use a different value for instances served from the same hostname.
# Browsers scope cookies by hostname, not port.
# FITNESS_OWNER_SESSION_COOKIE_NAME=open_fitness_isolated_session

# Optional display name.
FITNESS_OWNER_DISPLAY_NAME=Owner

# Optional agent and Apple Health automation boundaries. Use independent tokens.
# FITNESS_API_TOKEN=REPLACE_WITH_RANDOM_AGENT_TOKEN
# FITNESS_HEALTH_SYNC_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_HEALTH_TOKEN
